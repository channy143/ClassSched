<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClassSched.ViewModels"
             x:Class="ClassSched.Views.CreateAccountPage"
             x:DataType="vm:CreateAccountViewModel"
             Title="Create Account"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1E}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30">

            <!-- Back Button -->
            <HorizontalStackLayout>
                <Label Text="← Back to Login" 
                       TextColor="#512BD4"
                       FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Title -->
            <Label Text="Create Account" 
                   FontSize="28" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

            <Label Text="Fill in your details to get started" 
                   FontSize="14" 
                   TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Registration Form -->
            <Grid IsVisible="{Binding IsRegistrationStep}" ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- First Name -->
                <Frame Grid.Column="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                       BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                       CornerRadius="10" 
                       Padding="15,5">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="First Name" FontSize="12" TextColor="#8E8E93"/>
                        <Entry Text="{Binding FirstName}" 
                               Placeholder="First"
                               TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                               PlaceholderColor="#C7C7CC"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Last Name -->
                <Frame Grid.Column="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                       BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                       CornerRadius="10" 
                       Padding="15,5">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Last Name" FontSize="12" TextColor="#8E8E93"/>
                        <Entry Text="{Binding LastName}" 
                               Placeholder="Last"
                               TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                               PlaceholderColor="#C7C7CC"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Email -->
            <Frame IsVisible="{Binding IsRegistrationStep}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                   BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                   CornerRadius="10" 
                   Padding="15,5">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" FontSize="12" TextColor="#8E8E93"/>
                    <Entry Text="{Binding Email}" 
                           Placeholder="your.email@example.com"
                           Keyboard="Email"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                           PlaceholderColor="#C7C7CC"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Password -->
            <Frame IsVisible="{Binding IsRegistrationStep}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                   BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                   CornerRadius="10" 
                   Padding="15,5">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" FontSize="12" TextColor="#8E8E93"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" Text="{Binding Password}" 
                               Placeholder="Create a password"
                               IsPassword="{Binding IsPasswordHidden}"
                               TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                               PlaceholderColor="#C7C7CC"/>
                        <Button Grid.Column="1" Text="{Binding PasswordToggleText}"
                                FontSize="12" BackgroundColor="Transparent" TextColor="#512BD4"
                                Padding="5" Command="{Binding TogglePasswordCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Confirm Password -->
            <Frame IsVisible="{Binding IsRegistrationStep}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                   BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                   CornerRadius="10" 
                   Padding="15,5">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Confirm Password" FontSize="12" TextColor="#8E8E93"/>
                    <Entry Text="{Binding ConfirmPassword}" 
                           Placeholder="Confirm your password"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                           PlaceholderColor="#C7C7CC"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Create Account Button -->
            <Button IsVisible="{Binding IsRegistrationStep}" 
                    Text="Create Account" 
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Command="{Binding CreateAccountCommand}"
                    IsEnabled="{Binding IsNotBusy}"/>

            <!-- Verification Step -->
            <VerticalStackLayout IsVisible="{Binding IsVerificationStep}" Spacing="15">
                
                <Frame BackgroundColor="#E8F5E9" BorderColor="#4CAF50" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📧 Check your email!" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#2E7D32"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding VerificationMessage}" 
                               FontSize="14"
                               TextColor="#388E3C"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Enter the 6-digit verification code" 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                       HorizontalOptions="Center"/>

                <!-- Verification Code Entry -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" 
                       BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" 
                       CornerRadius="10" 
                       Padding="15,5">
<Entry Text="{Binding VerificationCode}" 
                            Placeholder="000000"
                            MaxLength="6"
                            Keyboard="Numeric"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                            PlaceholderColor="#C7C7CC"/>
                </Frame>

                <!-- Verify Button -->
                <Button Text="Verify Email" 
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="50"
                        Command="{Binding VerifyEmailCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Resend Code -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Didn't receive the code?" 
                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                           FontSize="14"/>
                    <Label Text="Resend" 
                           TextColor="#512BD4"
                           FontAttributes="Bold"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResendCodeCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- Error/Success Message -->
            <Label Text="{Binding Message}" 
                   TextColor="{Binding IsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF3B30|#34C759'}"
                   FontSize="14"
                   IsVisible="{Binding HasMessage}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}"
                               Color="#512BD4"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
