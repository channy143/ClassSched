<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClassSched.ViewModels"
             x:Class="ClassSched.Views.SettingsPage"
             Title="Settings"
             x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Settings" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#333" />

            <!-- Notifications Section -->
            <Border StrokeShape="RoundRectangle 12" 
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Notifications" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#512BD4" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Enable Reminders" 
                               FontSize="16" 
                               TextColor="#333"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                               IsToggled="{Binding NotificationsEnabled}" />
                    </Grid>

                    <BoxView HeightRequest="1" 
                            BackgroundColor="#E0E0E0" />

                    <Label Text="Reminder Time" 
                           FontSize="16" 
                           TextColor="#333" />
                    <Label Text="Send reminder before class starts" 
                           FontSize="12" 
                           TextColor="#999" />
                    
                    <Picker Title="Select reminder time"
                           ItemsSource="{Binding ReminderOptions}"
                           SelectedItem="{Binding ReminderMinutes}"
                           BackgroundColor="#F5F5F5"
                           TextColor="#333" />
                </VerticalStackLayout>
            </Border>

            <!-- Test Notification Section -->
            <Border StrokeShape="RoundRectangle 12" 
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Test Notifications" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#512BD4" />

                    <Label Text="Send a test notification to verify your settings are working correctly." 
                           FontSize="14" 
                           TextColor="#666" />

                    <Button Text="Send Test Notification"
                           BackgroundColor="#3498DB"
                           TextColor="White"
                           FontAttributes="Bold"
                           CornerRadius="25"
                           HeightRequest="45"
                           Command="{Binding TestNotificationCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- About Section -->
            <Border StrokeShape="RoundRectangle 12" 
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="About" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#512BD4" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="App Name:" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Label Text="Class Sched" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#333" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Version:" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Label Text="1.0.0" 
                               FontSize="14" 
                               TextColor="#333" />
                    </HorizontalStackLayout>

                    <Label Text="A simple and user-friendly class scheduling app built with .NET MAUI." 
                           FontSize="12" 
                           TextColor="#999"
                           Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Back Button -->
            <Button Text="Back to Schedule"
                   BackgroundColor="#512BD4"
                   TextColor="White"
                   FontAttributes="Bold"
                   CornerRadius="25"
                   HeightRequest="50"
                   Command="{Binding GoBackCommand}"
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
